# =====================================================================
# OpsBrain AI 环境变量配置模板
# =====================================================================
# 使用说明：
# 1. 复制本文件为 .env（执行命令：cp .env.example .env）
# 2. 填写真实的 API Key
# 3. .env 文件已在 .gitignore 中，不会被提交到 Git
# =====================================================================

# 阿里云百炼 API Key（必填）
# 获取方式：登录阿里云百炼控制台 → API 管理 → 创建 API Key
ALIBABA_API_KEY=your-real-api-key-here

# 示例：
# ALIBABA_API_KEY=sk-ws-H.EDLLMYI.3csC...

# =====================================================================
# AI 模型选型（可选，均有合理默认值）
# =====================================================================
# 端点与模型按供应商实测更新（2026-09-10 批 73 实测 api.123nhh.com）：
#   chat 主力/推理：gemini-3.1-flash-lite（支持 function calling）
#   embedding：⚠️ 该端点 13 个 embedding 模型无可用 1536 维——qwen3-embedding-8b
#   可用但仅支持 ≤1024 维（1536 实测三连败），与向量维度铁律 1536 冲突。
#   REAL 模式激活前需换支持 1536 的端点（OpenAI 官方 text-embedding-3-small
#   原生支持 1536 维）。
# 模型目录会变（gemini-2.5-flash / gemini-embedding-001 均已下架）——
# 换模型前先单实测；端点有「短窗多模型探测即封 IP」守卫，逐个验证勿连发。
#
# ALIBABA_BASE_URL=https://api.123nhh.com/v1
# ALIBABA_TURBO_MODEL=gemini-3.1-flash-lite
# ALIBABA_REASONER_MODEL=gemini-3.1-flash-lite
# ALIBABA_EMBEDDING_MODEL=qwen3-embedding-8b   # 仅 ≤1024 维,REAL 模式勿用
#
# 重排模型（reranker）：架构文档规划项（避坑指南 §混合检索），代码尚未
# 消费——接入混合检索重排位时再启用，当前仅占位。
# ALIBABA_reranker_MODEL=qwen3-reranker-8b

# =====================================================================
# 告警 Webhook 共享密钥（生产环境必填）
# =====================================================================
# /api/v1/alerts/webhook 无法走 Sa-Token 鉴权（Alertmanager 带不了 token），
# 但该端点会直接写库并触发自动建单。不设密钥 = 任何人可灌入伪造告警。
#
# 设置后，Alertmanager 推送必须携带请求头：X-Webhook-Token: <此值>
# 生成方式：openssl rand -hex 32
# ALERT_WEBHOOK_SECRET=

# 单来源 IP 每分钟最大告警推送数（默认 300，<=0 关闭限流）
# ALERT_WEBHOOK_RATE_LIMIT=300

# =====================================================================
# 超时与流式（可选，均有合理默认值）
# =====================================================================
# SSE 连接总超时（毫秒）。必须大于最慢模型的总超时（reasoner = 模型超时 ×2）
# SSE_TIMEOUT_MS=150000
# Spring MVC 异步请求超时（毫秒）。必须大于 SSE_TIMEOUT_MS
# MVC_ASYNC_TIMEOUT_MS=180000
