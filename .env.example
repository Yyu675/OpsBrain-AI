# =====================================================================
# OpsBrain AI 环境变量配置模板
# =====================================================================
# 使用说明：
# 1. 复制本文件为 .env（执行命令：cp .env.example .env）
# 2. 填写真实的 API Key
# 3. .env 文件已在 .gitignore 中，不会被提交到 Git
# =====================================================================

# =====================================================================
# 阿里云百炼（Bailian）渠道配置 — 2026-09-12 批 77 实测定稿
# =====================================================================
# 端点：https://dashscope.aliyuncs.com/compatible-mode/v1（百炼 OpenAI 兼容端点）
#
# ⚠️ 安全提醒：sk-ws-* 为百炼工作区签名 Key。若曾在对话/日志/截图中暴露，
#   请立即到百炼控制台删除并重新签发。本文件通过 .gitignore 排除，不会提交到 Git。
#
# ---- 渠道变量（application.yml channels.* 直读）----
# chat 渠道（turbo + reasoner 同渠道，双模分流是选型不是渠道边界）
#   注意：Agent ReAct 工具循环的硬前提是模型支持 function calling；
#   glm-5.2 是当前三个候选模型中唯一支持 function calling 的。
#   若换用其他模型，务必先验证 tools/functions 支持。
AI_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_API_KEY=your-real-chat-api-key-here
AI_CHAT_TURBO_MODEL=qwen-turbo
AI_CHAT_REASONER_MODEL=deepseek-v4-flash-0731

# embedding 渠道（RAG 检索核心，维度铁律 1536）
#   ⚠️ 关键：必须显式传 dimensions=1536（代码已做），不传则 qwen3.7-text-embedding
#      默认返回 1024 维 → pgvector VECTOR(1536) 写库报错「expected 1536, not 1024」
#   ✓ qwen3.7-text-embedding + dimensions=1536 → 返回 1536 维
#   ✓ text-embedding-v4 亦支持 1536（备选）；✗ text-embedding-v3 仅 ≤1024 勿用
AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_API_KEY=your-real-embedding-api-key-here
AI_EMBEDDING_MODEL=qwen3.7-text-embedding

# reranker 渠道（代码未消费，规划占位——接入混合检索重排位时启用）
# AI_RERANKER_MODEL=qwen3-reranker-8b

# ---- 回落兼容（ALIBABA_* 旧变量：channels.* 未配时兜底）----
# 若已配 AI_CHAT_* / AI_EMBEDDING_* 则以下失效；保持与上面同值防漂移
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=your-real-api-key-here
ALIBABA_TURBO_MODEL=qwen-turbo
ALIBABA_REASONER_MODEL=deepseek-v4-flash-0731
ALIBABA_EMBEDDING_MODEL=qwen3.7-text-embedding

# =====================================================================
# 模型渠道 Key 落库加密密钥（阶段A-P0，生产必填）
# =====================================================================
# 启动镜像把 API Key 写入 sys_ai_channel.api_key_enc。未配本变量时降级明文落库
# 并打 WARN——功能可用，但 DB dump / 备份即等于 Key 泄露。
# 生产务必设置。生成方式：openssl rand -hex 32
# 更换本密钥会使既有 enc:v1: 密文无法解密，需重启让镜像用新密钥重写。
# MODEL_KEY_CRYPT_SECRET=

# =====================================================================
# 告警 Webhook 共享密钥（生产环境必填）
# =====================================================================
# /api/v1/alerts/webhook 无法走 Sa-Token 鉴权（Alertmanager 带不了 token），
# 但该端点会直接写库并触发自动建单。不设密钥 = 任何人可灌入伪造告警。
#
# 设置后，Alertmanager 推送必须携带请求头：X-Webhook-Token: <此值>
# 生成方式：openssl rand -hex 32
# ALERT_WEBHOOK_SECRET=

# 单来源 IP 每分钟最大告警推送数（默认 300，<=0 关闭限流）
# ALERT_WEBHOOK_RATE_LIMIT=300

# =====================================================================
# 超时与流式（可选，均有合理默认值）
# =====================================================================
# SSE 连接总超时（毫秒）。必须大于最慢模型的总超时（reasoner = 模型超时 ×2）
# SSE_TIMEOUT_MS=150000
# Spring MVC 异步请求超时（毫秒）。必须大于 SSE_TIMEOUT_MS
# MVC_ASYNC_TIMEOUT_MS=180000
