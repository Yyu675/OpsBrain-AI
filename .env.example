# =====================================================================
# OpsBrain AI 环境变量配置模板
# =====================================================================
# 使用说明：
# 1. 复制本文件为 .env（执行命令：cp .env.example .env）
# 2. 填写真实的 API Key
# 3. .env 文件已在 .gitignore 中，不会被提交到 Git
# =====================================================================

# 阿里云百炼 API Key（必填）
# 获取方式：登录阿里云百炼控制台 https://bailian.console.aliyun.com → API 管理 → 创建 API Key
# Key 形如 sk-ws-xxxx（百炼工作区签名 Key），与下方 BASE_URL 配对使用。
ALIBABA_API_KEY=your-real-api-key-here

# 示例：
# ALIBABA_API_KEY=sk-ws-H.xxxxxxxx.xxxxx

# =====================================================================
# AI 模型选型（可选，均有合理默认值）
# =====================================================================
# 端点：阿里云百炼 OpenAI 兼容端点（2026-09-12 批 77 实测确认）
#   ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 模型实测（百炼端点 + 新 Key）：
#   chat：glm-5.2 ✓（推理模型，function calling ✓；流式先吐 reasoning_content，content 在末尾，
#         打字机 UX 退化为「静默-末尾爆发」——非理想 turbo）。百炼原生快速非推理 chat
#         模型 qwen-turbo/flash/plus 在「仅用免费额度」模式下 403 额度耗尽；关闭该模式后
#         可用 qwen-turbo 作 turbo（快/便宜/流式顺），glm-5.2 作 reasoner（复杂推理）。
#   embedding：qwen3.7-text-embedding ✓ 支持 1536 维（向量铁律满足）；
#         text-embedding-v4 ✓ 亦支持 1536（备选）；text-embedding-v3 ✗ 仅 ≤1024。
#
# 推荐配置（关闭「仅用免费额度」后最佳）：
# ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ALIBABA_TURBO_MODEL=qwen-turbo
# ALIBABA_REASONER_MODEL=glm-5.2
# ALIBABA_EMBEDDING_MODEL=qwen3.7-text-embedding
#
# 重排模型（reranker）：架构文档规划项（避坑指南 §混合检索），代码尚未
# 消费——接入混合检索重排位时再启用，当前仅占位。
# ALIBABA_reranker_MODEL=qwen3-reranker-8b

# =====================================================================
# 告警 Webhook 共享密钥（生产环境必填）
# =====================================================================
# /api/v1/alerts/webhook 无法走 Sa-Token 鉴权（Alertmanager 带不了 token），
# 但该端点会直接写库并触发自动建单。不设密钥 = 任何人可灌入伪造告警。
#
# 设置后，Alertmanager 推送必须携带请求头：X-Webhook-Token: <此值>
# 生成方式：openssl rand -hex 32
# ALERT_WEBHOOK_SECRET=

# 单来源 IP 每分钟最大告警推送数（默认 300，<=0 关闭限流）
# ALERT_WEBHOOK_RATE_LIMIT=300

# =====================================================================
# 超时与流式（可选，均有合理默认值）
# =====================================================================
# SSE 连接总超时（毫秒）。必须大于最慢模型的总超时（reasoner = 模型超时 ×2）
# SSE_TIMEOUT_MS=150000
# Spring MVC 异步请求超时（毫秒）。必须大于 SSE_TIMEOUT_MS
# MVC_ASYNC_TIMEOUT_MS=180000
