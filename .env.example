# =====================================================================
# OpsBrain AI 环境变量配置模板
# =====================================================================
# 使用说明：
# 1. 复制本文件为 .env（执行命令：cp .env.example .env）
# 2. 填写真实的 API Key
# 3. .env 文件已在 .gitignore 中，不会被提交到 Git
# =====================================================================

# 阿里云百炼 API Key（必填）
# 获取方式：登录阿里云百炼控制台 → API 管理 → 创建 API Key
ALIBABA_API_KEY=your-real-api-key-here

# 示例：
# ALIBABA_API_KEY=sk-ws-H.EDLLMYI.3csC...
