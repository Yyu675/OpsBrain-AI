<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>cn.bgyueyu</groupId>
    <artifactId>devops-platform-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>devops-platform-backend</name>
    <description>devops-platform-backend</description>

    <properties>
        <java.version>21</java.version>
        <!-- LangChain4j 统一版本；升级只需改这一处 -->
        <!--
          1.1.0 → 1.2.0：修 AbstractGuardrailService 的并发缺陷。

          1.1.0 里那四个缓存用的是普通 HashMap，而 DefaultAiServices 的动态代理
          是所有请求共用的单例。并发调用同一 AI Service 方法时多线程同时进入
          computeIfAbsent，JDK 9+ 的 modCount 校验会抛 ConcurrentModificationException，
          被应用层兜底 catch 吞成一句「50001 服务内部异常」。

          上游 issue #3335「Guardrails implementation not thread-safe」已修复
          （四个 Map 全部改为 ConcurrentHashMap），本项目核对过 1.2.0 的源码确认包含该修复。
          另有 issue #3558 报告的正是本项目遇到的同一条堆栈，至今仍 open——
          说明它就是 #3335 未升级版本的重现。

          选 1.2.0 而非最新的 1.19.x：这是**包含修复的最小跨度**。
          langchain4j 1.x 期间 API 仍在演进，而本项目重度依赖
          TokenStream / AiServices / ChatMemoryProvider 等接口，
          跨十几个小版本的收益（新特性）远不及回归风险。
          修完这个具体缺陷即止，后续升级应单独评估。
        -->
        <langchain4j.version>1.2.0</langchain4j.version>

        <!-- fabric8 K8s 客户端版本（V1.2 执行器适配器，2026-08-26）
             6.13.x 为 2024 年稳定线，支持 K8s 1.28+；如需最新 API 再评估升级 -->
        <fabric8.version>6.13.4</fabric8.version>

        <!--
          让 javac 把每条诊断打成 GitHub Actions 的 workflow command，
          从而变成一条 annotation。

          缘由：CI 的原始日志存放在 Azure blob
          （productionresultssa7.blob.core.windows.net），部分开发/排障环境
          访问不到，只能读 annotations API，而它默认只给一句
          "Process completed with exit code 1"，看不到究竟哪一行编译错了。
          打成 annotation 后，错误会同时出现在 PR 的 Files changed 视图里，
          评审时不必点进日志翻。
        -->
        <maven.compiler.showWarnings>true</maven.compiler.showWarnings>
    </properties>

    <!-- 用 LangChain4j BOM 统一托管所有 langchain4j-* 子模块版本，避免版本错配 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ================= Web / 参数校验 ================= -->
        <!-- 经典命名：spring-boot-starter-web（含 Spring MVC + 内嵌 Tomcat，支持 SseEmitter） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- WebSocket（L2 告警推送 AlertStreamMode） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- ================= 自身可观测性（P2，2026-08-26 新增）=================
             系统能监控别人（Prometheus 代理查询），也要能监控自己：
             /actuator/health 供 K8s 探针与部署健康检查；/actuator/prometheus
             暴露自身指标（工具调用/Saga 补偿/LLM 成本）供 Prometheus 抓取。
             注意：/actuator/** 不在 /api/** 下，不会被 SaInterceptor 拦截，
             必须在 WebConfig 显式配置鉴权（见 WebConfig 注释），否则内部指标裸奔公网。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- ================= 真实执行器（V1.2，D1 适配器模式）=================
             K8s 适配器实现依赖。CI 用 kubernetes-server-mock（FakeK8sClient）测试，
             不依赖真实集群；演示用本机 kind + KubeConfig。凭证不进仓库。 -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-client</artifactId>
            <version>${fabric8.version}</version>
        </dependency>

        <!-- ================= 对象存储（工单附件） ================= -->
        <!-- MinIO SDK：S3 兼容协议，生产可平滑切换到阿里云 OSS / AWS S3 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.12</version>
        </dependency>

        <!-- ================= 数据访问 ================= -->
        <!-- JPA（ORM 实体管理，提供 JpaRepository、@Entity 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- JdbcTemplate（Dashboard 聚合查询用）由 data-jdbc 提供 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <!-- PostgreSQL 驱动（连接 pgvector 容器） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ================= Redis（语义缓存 / 会话） ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ================= LangChain4j（版本由 BOM 托管） ================= -->
        <!-- 核心模块（提供 ChatLanguageModel / EmbeddingModel 接口） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <!-- 声明式 @AiService / @Tool 自动装配 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
        </dependency>
        <!-- OpenAI 兼容客户端（对接 DeepSeek / 阿里云百炼） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
        </dependency>
        <!-- OpenAI 核心实现（OpenAiChatModel / OpenAiEmbeddingModel） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <exclusions>
                <!-- 排除 JDK HTTP 客户端，统一使用 Spring RestClient -->
                <exclusion>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>langchain4j-http-client-jdk</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- PgVector 向量存储 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-pgvector</artifactId>
        </dependency>

        <!-- ================= 工具 ================= -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ================= 鉴权（方向三：Sa-Token + BCrypt）================= -->
        <!-- Sa-Token：dromara 出品的轻量 Java 权限认证框架（国内最常用）。
             负责 token 签发/校验/登录态/登出；用户源与密码校验仍由本项目 sys_user + BCrypt 承担。
             Spring Boot 3.x 用 spring-boot3-starter。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>1.44.0</version>
        </dependency>
        <!-- Sa-Token 整合 Redis（jackson 序列化）：token 存 Redis，实现真正的服务端登出、
             多实例共享登录态。复用项目已有的 Redis（不同 key 前缀 satoken:，不干扰业务缓存）。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
            <version>1.44.0</version>
        </dependency>
        <!-- Redis 连接池（sa-token-redis-template 需要；版本由 spring-boot BOM 管理） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- 密码哈希：jBCrypt（纯 BCrypt 实现，~3KB 零传递依赖）。
             Sa-Token 不管密码校验，用户名密码比对仍用 BCrypt。 -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- ================= API 文档（P0-2）=================
             springdoc-openapi：从 Controller 反射生成 OpenAPI 3 契约。

             为什么需要：130 个端点此前无机器可读契约，前后端靠人工维护 TS 类型
             对齐，已因此出过 95 号那类事故（同一个错误码在两侧语义相反）。

             版本 2.8.15 的选择依据（不是随手挑的最新版）：
             - springdoc 官方版本表：Spring Boot [3.5.0, 4.0.0) 对应 2.8.15；
             - 2.8.1~2.8.12 与 Spring Boot 3.5.x 有已知不兼容（社区实测报告）；
             - 2.8.16 在「不使用 Spring Boot 自动配置」的应用上有启动失败问题
               （springdoc#3288，已于 2026-07 修复）。本项目用标准
               @SpringBootApplication，不属于该场景，但仍取官方基线版更稳。

             ⚠️ 收益边界（前置调研，见 PROGRESS.md）：本项目 130 个端点里
             70 个返回 Map<String,Object> 或 Object，OpenAPI 对这些只能生成
             additionalProperties:true。本次接入先拿到 60 个强类型端点的契约，
             Map 型端点需后续逐个换成 record DTO 才能产出有效 schema。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.15</version>
        </dependency>

        <!-- ================= 测试 ================= -->
        <!-- 经典命名：spring-boot-starter-test（含 JUnit 5、AssertJ、Mockito 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              测试失败详情**同时**进控制台与 target/surefire-reports/*.txt。

              动因：本项目的 CI 日志走 Azure blob，而 artifact 下载在受限网络下
              取不到（返回 0 字节）。默认配置下控制台只有
              「Tests run: 9, Failures: 9」这一行，**看不到任何一条失败原因**——
              排查时只能靠猜，而猜错方向会把本来正确的产品代码改坏。

              ⚠️ 这里曾配成 useFile=false，结果与 mvnw 里的 surefire 重放逻辑
              互相打架：useFile=false 让 surefire **不再写 .txt**，
              而 mvnw 那段恰恰是去读 .txt 的，于是「找到 0 个报告」，
              详情一条也出不来。两个各自正确的修复合在一起变成了死局，
              且双方都不报错——CI 探针打出「Tests行=183 但 surefire 报告 0 个」
              才把它暴露出来。

              现改为保留默认 useFile=true（写文件，供 mvnw 重放与 artifact 上传），
              另开 useUnlimitedThreads 无关项不动；trimStackTrace=false 保留，
              它让 Caused by 链完整，是定位根因的关键。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
              已移除 maven-toolchains-plugin。

              它在 validate 阶段就要求存在 ~/.m2/toolchains.xml 并从中匹配
              JDK 21，否则直接失败：
                  Cannot find matching toolchain definitions for: {version=21}

              而 CI 用 actions/setup-java 装 JDK 并不会生成 toolchains.xml，
              新克隆仓库的开发机同样没有——于是「装好 JDK 21 却仍然构建失败」，
              且报错指向 toolchain 而非真实原因，极难定位。

              这个插件本身也是多余的：上面 <java.version>21</java.version>
              已通过 spring-boot-starter-parent 传给 maven.compiler.release，
              编译目标版本由它单点决定。真正要防的是「用 JDK 17 去构建」，
              那应当由 CI 的 setup-java 与 enforcer 保证，而不是 toolchains
              ——后者只是换了个地方再声明一遍同一件事（同一事实两处定义）。
            -->

            <!--
              编译诊断以 GitHub Actions workflow command 格式输出。

              解决的是「CI 红了但看不到为什么」：原始日志存放在 Azure blob，
              部分排障环境访问不到，annotations API 又只给
              "Process completed with exit code 1"。
              加上 -Xplugin 式的输出前缀后，javac 的每条 error 都会被
              GitHub 识别成 annotation，可通过 API 读取，也会直接标注在
              PR 的对应代码行上。

              仅在 CI 生效（-Dci.annotations=true），本地构建不受影响——
              本地终端里 ::error:: 前缀反而碍眼。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 完整输出诊断，不因数量多而截断 -->
                    <compilerArgs>
                        <arg>-Xmaxerrs</arg>
                        <arg>1000</arg>
                        <arg>-Xmaxwarns</arg>
                        <arg>200</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
